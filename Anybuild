load("//anybuild/tools:python.bzl", "python_build", "python_config", "python_serve")

config = python_config(
    schema = 1,
    # WASIX wheels (PyYAML, rpds-py, ...) exist only for CPython 3.13/3.14.
    python_version = "3.13",
    commands = {
        "start": "cd core && python manage.py migrate --noinput && gunicorn core.wsgi:application --bind 0.0.0.0:8080",
    },
)

build = python_build(config)

python_serve(
    config,
    build,
    name = "todo-app",
    build_pre = [
        copy("requirements.txt"),
    ],
    build_post = [
        # The placeholders only let settings.py import during the build; real
        # secrets (SECRET_KEY, EMAIL_*) must be set in the Wasmer environment.
        run(
            "cd core && SECRET_KEY=build-only EMAIL_HOST_USER=build-only EMAIL_HOST_PASSWORD=build-only python manage.py collectstatic --noinput",
            group = "build",
        ),
    ],
    extra_env = {
        "WASMER": "true",
        "DEBUG": "False",
    },
)
