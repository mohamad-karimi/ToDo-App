load("//anybuild/tools:python.bzl", "python_build", "python_config", "python_serve")

config = python_config(
    schema = 1,
    python_version = "3.13",
    app_subdir = "core",
    python_framework = "django",
    python_server = "uvicorn",
    asgi_application = "core.asgi:application",
)

build = python_build(config)

python_serve(
    config,
    build,
    name = "todo-app",

    build_pre = [
        copy("requirements.txt"),
    ],

    build_post = [
        run(
            "cd core && SECRET_KEY=build-only EMAIL_HOST_USER=build-only EMAIL_HOST_PASSWORD=build-only python manage.py migrate --noinput && SECRET_KEY=build-only EMAIL_HOST_USER=build-only EMAIL_HOST_PASSWORD=build-only python manage.py collectstatic --noinput",
            group = "build",
        ),
    ],

    extra_env = {
        "WASMER": "true",
        "DEBUG": "False",
    },
)